# ---------------------------------------------------------------------------
# MIRSAD relay configuration
# Copy this file to `.env` for local development, then edit the values.
# On Render, add the same keys under Environment instead of committing .env.
# ---------------------------------------------------------------------------

# HTTP server
PORT=3000
HOST=0.0.0.0

# Shared secret required for POST /api/upload-frame and POST /api/sensors.
# Leave empty to disable authentication (fine for local testing only).
UPLOAD_TOKEN=

# Comma-separated browser origins allowed to call the API. Use * for same-origin
# deployments where the frontend and relay share a hostname.
ALLOWED_ORIGINS=*

# Render sits behind a proxy; keep true so req.ip uses X-Forwarded-For.
TRUST_PROXY=true

# Live-only by default. Set to true only if you want the synthetic camera and
# sensor demo while no hardware is connected.
DEMO_FALLBACK=false
DEMO_FPS=8

# ---------------------------------------------------------------------------
# LiveKit Cloud (replaces Render for live video)
# ---------------------------------------------------------------------------
# Copy these from the LiveKit dashboard. The API secret never reaches browsers.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=live
# Join-token lifetime in seconds (default 6 hours).
LIVEKIT_TOKEN_TTL=21600

# JPEG encoder quality (40-95).
JPEG_QUALITY=80

# Defaults used when the ESP32 does not send w/h/format query parameters.
# The firmware sends ?w=320&h=240&format=rgb565be, which overrides these.
FRAME_WIDTH=320
FRAME_HEIGHT=240
FRAME_FORMAT=rgb565be

# Maximum accepted upload body (bytes) and how old the newest frame may be
# before the dashboard reports it as stale.
MAX_FRAME_BYTES=2097152
FRAME_STALE_MS=5000

# WebRTC data-channel peers. 4 is enough for a small dashboard team.
MAX_WEBRTC_PEERS=4

# Metered TURN (optional but strongly recommended for restricted networks).
# Create an app at https://www.metered.ca/ and copy the app domain + API key.
# The API key stays on the server; browsers only receive short-lived credentials.
METERED_DOMAIN=
METERED_API_KEY=
METERED_REGION=
METERED_TTL_MS=1800000

# Comma-separated STUN URLs used when Metered is not configured.
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Set true only while debugging; logs every HTTP request.
LOG_REQUESTS=false
